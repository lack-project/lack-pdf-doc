{
  "name": "lack/pdf-doc",
  "type": "library",
  "description": "Document-oriented convenience layer for tc-lib-pdf with reusable HTML/CSS templates.",
  "license": "MIT",
  "authors": [{"name": "Matthias Leuffen", "email": "leuffen@continue.de"}],
  "autoload": {"psr-4": {"Lack\\PdfDoc\\": "src/"}},
  "require": {
    "php": ">=8.5",
    "phore/filesystem": "^1.1.1",
    "phore/markdown": "dev-main",
    "tecnickcom/tc-lib-pdf": "^8.0"
  },
  "require-dev": {"phpunit/phpunit": "^13.2"},
  "scripts": {
    "tc-lib-pdf-fonts": [
      "[ -d vendor/tecnickcom/tc-lib-pdf-font ] && make -C vendor/tecnickcom/tc-lib-pdf-font deps fonts || true"
    ],
    "post-install-cmd": ["@tc-lib-pdf-fonts"],
    "post-update-cmd": ["@tc-lib-pdf-fonts"]
  },
  "config": {"preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable"
}
