{
  "name": "lack-project/lack-pdf-doc",
  "type": "library",
  "description": "Generate styled PDF documents from Markdown with reusable HTML/CSS templates.",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Lack\\PdfDoc\\": "src/"
    }
  },
  "require": {
    "php": ">=8.5",
    "phore/markdown": "^1.0",
    "tecnickcom/tc-lib-pdf": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2.2"
  },
  "config": {
    "preferred-install": "source",
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "stable"
}
